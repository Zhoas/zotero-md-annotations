{
  "manifest_version": 2,
  "name": "Zotero Markdown Annotations",
  "version": "0.1.0",
  "description": "Render Markdown natively within Zotero PDF annotation comments.",
  "author": "Zhoas & Gemini",
  "homepage_url": "https://github.com/Zhoas/zotero-md-annotations",
  "applications": {
    "zotero": {
      "id": "zotero-md-annotations@zhoas.com",
      "strict_min_version": "6.999",
      "strict_max_version": "10.99.99"
    }
  },
  "web_accessible_resources": [
    "lib/*"
  ]
}
